{"repo": {"name": {"en-US": "KabelWacht"}, "description": {"en-US": "Personal F-Droid repository that publishes signed KabelWacht releases, built automatically from tagged commits in CI."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "d0b311be83fcc8705caefd859b5cc803fadd22edc3ef0a7d883c0cd372a0da36", "size": 7676}}, "address": "https://muelli.github.io/KabelWacht/fdroid/repo", "timestamp": 1787135245000, "categories": {"Connectivity": {"name": {"en-US": "Connectivity"}}, "Security": {"name": {"en-US": "Security"}}, "VPN & Proxy": {"name": {"en-US": "VPN & Proxy"}}}}, "packages": {"com.github.muelli.kabelwacht": {"metadata": {"added": 1787135243000, "categories": ["Connectivity", "Security", "VPN & Proxy"], "changelog": "https://github.com/muelli/KabelWacht/releases", "issueTracker": "https://github.com/muelli/KabelWacht/issues", "lastUpdated": 1787135244000, "license": "AGPL-3.0-or-later", "sourceCode": "https://github.com/muelli/KabelWacht", "screenshots": {"phone": {"en-US": [{"name": "/com.github.muelli.kabelwacht/en-US/phoneScreenshots/1.png", "sha256": "dbd313892bdfa7b7b9f77dd055ff371f0985f6d4f9ac8ecbc64fbb5d7c7dc334", "size": 59156}, {"name": "/com.github.muelli.kabelwacht/en-US/phoneScreenshots/2.png", "sha256": "e0bc4c248c067ea307b73bf1a858a242b92cb45801a8d35761e7182d3dccc794", "size": 127885}, {"name": "/com.github.muelli.kabelwacht/en-US/phoneScreenshots/3.png", "sha256": "f8268b5f317cfd8c7b641d8aef25d370955446af242a421371c4a1b4d2ed9779", "size": 204489}, {"name": "/com.github.muelli.kabelwacht/en-US/phoneScreenshots/4.png", "sha256": "c382672d4319a9749091f5916a0a865f9921b739d482726fb248da7a69fd448b", "size": 79077}, {"name": "/com.github.muelli.kabelwacht/en-US/phoneScreenshots/5.png", "sha256": "f1ad31e04c03057462dd7d2e417f2479792690800b0da1aa16699ec091f3a068", "size": 55168}]}}, "authorName": "Tobias Mueller", "name": {"en-US": "KabelWacht"}, "summary": {"en-US": "A simple, free WireGuard VPN client: scan, import, and manage tunnels."}, "description": {"en-US": "KabelWacht is a minimal, fully free-software WireGuard® client for Android.\n\nIt does one thing well: manage WireGuard tunnels and connect.\n\nFeatures:\n\n* Create, list, edit and delete WireGuard profiles.\n* Import a configuration by scanning a QR code.\n* Import a configuration from a .conf file.\n* One-tap connect/disconnect with a per-tunnel switch.\n* Userspace WireGuard backend — no root required.\n\nPrivacy and freedom:\n\n* 100% free and open-source software (AGPL-3.0-or-later).\n* No trackers, no analytics, no advertising.\n* No Google Play Services or other proprietary dependencies.\n* The only network connection made is your own WireGuard tunnel.\n\nBuilt on the official WireGuard tunnel library and the ZXing QR decoder.\n\nWireGuard is a registered trademark of Jason A. Donenfeld. This project is not\nofficially affiliated with or endorsed by the WireGuard project.\n"}, "icon": {"en-US": {"name": "/com.github.muelli.kabelwacht/en-US/icon_zzyLzh1Ecmt4ffPiOm_OK1Os0jQ8X5GkJIP8LQnJOh8=.png", "sha256": "cf3c8bce1d44726b787df3e23a6fce2b53acd2343c5f91a42483fc2d09c93a1f", "size": 6747}}, "preferredSigner": "8f02760a5c600a686c7ff452521c7a4be9f8ced922cdc7f9fc639b068625c289"}, "versions": {"0457f7037c69529720a7d9ff62dddce9ab0eb9f3adfe7cbc20c2a54ca01df2bc": {"added": 1787135244000, "file": {"name": "/kabelwacht-80-rc.apk", "sha256": "0457f7037c69529720a7d9ff62dddce9ab0eb9f3adfe7cbc20c2a54ca01df2bc", "size": 16836784}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "80-rc", "versionCode": 80, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 35}, "signer": {"sha256": ["8f02760a5c600a686c7ff452521c7a4be9f8ced922cdc7f9fc639b068625c289"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "com.github.muelli.kabelwacht.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "releaseChannels": ["Beta"]}, "b4a4c