{"repo": {"timestamp": 1785717095000, "version": 20002, "name": "KabelWacht", "icon": "icon.png", "address": "https://muelli.github.io/KabelWacht/fdroid/repo", "description": "Personal F-Droid repository that publishes signed KabelWacht releases, built automatically from tagged commits in CI."}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["fdroid"], "suggestedVersionCode": "2147483647", "license": "Unknown", "name": "KabelWacht", "added": 1785498229000, "packageName": "com.github.muelli.kabelwacht", "lastUpdated": 1785707863000, "localized": {"en-US": {"description": "KabelWacht is a minimal, fully free-software WireGuard\u00ae client for Android.\n\nIt does one thing well: manage WireGuard tunnels and connect.\n\nFeatures:\n\n* Create, list, edit and delete WireGuard profiles.\n* Import a configuration by scanning a QR code.\n* Import a configuration from a .conf file.\n* One-tap connect/disconnect with a per-tunnel switch.\n* Userspace WireGuard backend \u2014 no root required.\n\nPrivacy and freedom:\n\n* 100% free and open-source software (AGPL-3.0-or-later).\n* No trackers, no analytics, no advertising.\n* No Google Play Services or other proprietary dependencies.\n* The only network connection made is your own WireGuard tunnel.\n\nBuilt on the official WireGuard tunnel library and the ZXing QR decoder.\n\nWireGuard is a registered trademark of Jason A. Donenfeld. This project is not\nofficially affiliated with or endorsed by the WireGuard project.\n", "icon": "icon_zzyLzh1Ecmt4ffPiOm_OK1Os0jQ8X5GkJIP8LQnJOh8=.png", "name": "KabelWacht", "phoneScreenshots": ["1.png", "2.png", "3.png"], "summary": "A simple, free WireGuard VPN client: scan, import, and manage tunnels."}}}], "packages": {"com.github.muelli.kabelwacht": [{"added": 1785516117000, "apkName": "kabelwacht-4.apk", "hash": "61c2b232e13a18d39213699808057e01713415e554e955a56185a7fbfdfffce2", "hashType": "sha256", "minSdkVersion": 29, "nativecode": ["arm64-v8a", "armeabi-v7a", "x